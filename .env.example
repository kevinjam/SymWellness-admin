# Where the admin console sends API requests.
#
# - Leave EMPTY in development: requests go to the Vite dev server, which proxies
#   /api to VITE_DEV_API_TARGET (below). No CORS configuration needed.
# - In production set the full API origin, e.g. https://api.symhealth-ai.com
#   (and add this console's origin to CORS_ORIGIN on the backend), or serve the
#   console from the same origin as the API and leave this empty.
VITE_API_BASE_URL=

# Dev proxy target (only used by `npm run dev`).
VITE_DEV_API_TARGET=http://localhost:9000
